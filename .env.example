# Kommo — private integration credentials
# Copy to .env and fill with real values. NEVER commit .env.

# Subdomain only (from https://<SUBDOMAIN>.kommo.com) — no ".kommo.com", no https://
KOMMO_SUBDOMAIN=

# Long-lived token from: Kommo > Settings > Integrations > <your private integration>
#   > Keys and scopes > Generate long-lived token
KOMMO_LONG_LIVED_TOKEN=

# --- Optional, only if a feature needs it (explained before use) ---
# Integration client secret (only for Salesbot webhook / widget_request JWT validation)
KOMMO_CLIENT_SECRET=
# Integration ID (client_id) — same reason
KOMMO_INTEGRATION_ID=

# --- Business config (Phase 8+) — no secrets, safe defaults empty ---
MONKITS_STORE_URL=
MONKITS_WEBSITE_URL=
