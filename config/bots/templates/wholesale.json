[
  {
    "question": [
      { "handler": "show", "params": { "type": "text", "value": "¡Gracias por tu interés en mayoreo! Para prepararte una cotización necesito algunos datos rápidos." } },
      { "handler": "action", "params": { "name": "set_tag", "params": { "type": 2, "value": "COTIZACION" } } }
    ]
  },
  {
    "question": [ { "handler": "show", "params": { "type": "text", "value": "¿Aproximadamente cuántos kits necesitas?" } } ],
    "answer": [ { "handler": "action", "params": { "name": "set_custom_fields", "params": { "type": 2, "custom_fields_id": "@field:MK_CANTIDAD_KITS", "value": "{{message}}" } } } ]
  },
  {
    "question": [ { "handler": "show", "params": { "type": "text", "value": "¿Para qué los vas a usar? (escuela, evento, reventa, etc.)" } } ],
    "answer": [ { "handler": "action", "params": { "name": "set_custom_fields", "params": { "type": 2, "custom_fields_id": "@field:MK_INTERES", "value": "{{message}}" } } } ]
  },
  {
    "question": [ { "handler": "show", "params": { "type": "text", "value": "¿En qué ciudad y estado estás? (para calcular envío)" } } ],
    "answer": [ { "handler": "action", "params": { "name": "set_custom_fields", "params": { "type": 2, "custom_fields_id": "@field:MK_CIUDAD", "value": "{{message}}" } } } ]
  },
  {
    "question": [ { "handler": "show", "params": { "type": "text", "value": "¿Nombre de la escuela / empresa / negocio? (si aplica)" } } ],
    "answer": [ { "handler": "action", "params": { "name": "set_custom_fields", "params": { "type": 2, "custom_fields_id": "@field:MK_NOMBRE_ORG", "value": "{{message}}" } } } ]
  },
  {
    "question": [ { "handler": "show", "params": { "type": "text", "value": "Por último, déjame un teléfono y un correo para enviarte la cotización." } } ],
    "answer": [
      {
        "handler": "preset",
        "params": {
          "name": "contacts.validate_base_info",
          "params": {
            "empty_email": "Me falta tu correo, ¿me lo compartes?",
            "empty_phone": "Me falta tu teléfono, ¿me lo compartes?",
            "success": "¡Listo, gracias!"
          }
        }
      }
    ]
  },
  {
    "finish": [
      { "handler": "action", "params": { "name": "set_custom_fields", "params": { "type": 2, "custom_fields_id": "@field:MK_ESTADO_COMERCIAL", "value": "DATOS_RECOPILADOS" } } },
      { "handler": "action", "params": { "name": "set_tag", "params": { "type": 2, "value": "ASESOR_REQUERIDO" } } },
      { "handler": "action", "params": { "name": "unset_tag", "params": { "type": 2, "value": "BOT_ATENDIENDO" } } },
      { "handler": "show", "params": { "type": "text", "value": "¡Gracias! Un asesor te prepara la cotización y te contacta pronto. Horario: L-V 10:00-18:00, sábados 10:00-14:00. El pago de mayoreo es por transferencia." } },
      { "handler": "action", "params": { "name": "change_status", "params": { "value": "@stage:mayoreo/datos_completos" } } },
      { "handler": "stop", "params": { "action": "talk-close" } }
    ]
  }
]
